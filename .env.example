# tezzeract-auth — environment template.
#
# Copy to .env and fill in. Every value below is a placeholder: there are no
# real secrets in this file and none may ever be committed to it.
# server/src/config/env.ts validates all of this at startup and refuses to
# boot with a report naming every problem at once.

# ---------------------------------------------------------------- runtime ---

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public origin of this service, and the `iss` claim in every token.
# Must be a bare origin: no path, no query, no trailing slash.
# Must be https when NODE_ENV=production.
AUTH_ISSUER=http://localhost:3000

# Proxy hops to trust for req.ip. 0 for local, 1 behind a single load
# balancer or ngrok. A wrong value breaks per-IP rate limiting: too high and
# a client can spoof its address with X-Forwarded-For, too low and every user
# is counted as the proxy.
TRUST_PROXY_HOPS=0

# ngrok / HTTPS tunnel (example — use your own subdomain):
# AUTH_ISSUER=https://your-subdomain.ngrok-free.dev
# TRUST_PROXY_HOPS=1
# Add https://your-subdomain.ngrok-free.dev/api/oauth/callback in Supabase.
# Sign-in must start at /authorize from an app, not by opening /login alone.
# Optional: override dev OIDC callback when testing without a product app (development only).
# Defaults to {AUTH_ISSUER}/dev/callback when ALLOW_LOCALHOST_CLIENTS=true.
# DEV_REDIRECT_URI=https://your-subdomain.ngrok-free.dev/dev/callback

# --------------------------------------------------------------- database ---

# OIDC provider storage, sessions, rate-limit counters, and the read-only
# memberships table. Migrations run automatically at startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tezzeract_auth

# Supabase-hosted Postgres: use **Session pooler** URI from Dashboard →
# Project Settings → Database → Connect (not "Direct connection").
# Direct `db.<ref>.supabase.co` is often IPv6-only and fails locally with
# ENOTFOUND. Append ?sslmode=require if it is not already in the URI.
# Example shape (region varies):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional. Set to a disposable database to run the rate limiter's
# integration tests, which are skipped otherwise.
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/tezzeract_auth_test

# --------------------------------------------------------------- supabase ---

# The credential store: passwords, MFA, email verification and recovery.
SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE key. Full administrative access to your Supabase project.
# Server-side only: it must never appear in a frontend bundle, a log line, an
# error message or a browser. It is confined to server/src/services/credentials.ts.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# Anon (publishable) key. Used server-side only for Google OAuth PKCE; never
# bundled into web/. Dashboard → Project Settings → API → anon public.
SUPABASE_ANON_KEY=replace-me-anon-key

# ---------------------------------------------------------------- secrets ---

# At least 32 characters each. Generate with:
#   openssl rand -base64 48
# Kept separate so rotating one does not invalidate the other.
COOKIE_SECRET=replace-me-with-at-least-32-random-characters
CSRF_SECRET=replace-me-with-a-different-32-plus-random-string

# Token signing keys: base64 of a JSON array of private JWKs.
# The first key signs; all keys are published at /jwks so tokens issued before
# a rotation keep verifying. Two keys maximum. Generate one with:
#   pnpm --filter @tezzeract/auth-server keygen
# See the README section "Rotating keys".
OIDC_SIGNING_KEYS=replace-me-base64-json-array-of-jwks

# ----------------------------------------------------------------- tokens ---

# Access token lifetime in seconds, 300-900. This is the window in which a
# revoked membership can still appear valid in a token, so it is kept short.
ACCESS_TOKEN_TTL=900

# After sign-in, land on /welcome (with sign out) before resuming OIDC.
# Unset defaults to true in development, false in production.
# POST_LOGIN_WELCOME=true

# ------------------------------------------------------------ development ---

# Adds http://localhost callbacks to the client registry. The env schema
# REFUSES this in production; it is not merely ignored there.
ALLOW_LOCALHOST_CLIENTS=true

# ------------------------------------------------------- frontend (web/) ----
#
# Vite only exposes variables prefixed VITE_. Never put a secret in one:
# anything prefixed VITE_ is compiled into the browser bundle.

# Runs the frontend against the in-memory mock API, with no server, database
# or Supabase. Excluded from production builds.
# VITE_USE_MOCKS=true

# Origin the Vite dev server proxies /api and the OIDC endpoints to.
# AUTH_SERVER_ORIGIN=http://localhost:3000
